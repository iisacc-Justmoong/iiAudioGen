          "`6ce78584eee4ae193b3dc368ed79e017e32a541a127299366de14a882dd69989`"
        ],
        [
          "`build/real-audioldm2/bells.wav`",
          "3초, 44.1kHz, 모노, PCM16",
          "`68da91bc8158781ef73381d86c959b9edc7aad4e9753d5f7e7d0b5752076d3c6`"
        ],
        [
