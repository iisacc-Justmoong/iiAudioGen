if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
set(fixture "${SOURCE_ROOT}/resources/test-fixtures")
if(NOT EXISTS "${fixture}/python fixture")
    message(FATAL_ERROR "The runtime fixture must live under resources/test-fixtures")
endif()
foreach(mode ok error badpcm badlength crash timeout)
    if(NOT IS_DIRECTORY "${fixture}/${mode}")
        message(FATAL_ERROR "Missing fixture directory: ${mode}")
    endif()
endforeach()
