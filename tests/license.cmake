if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()

file(SHA256 "${SOURCE_ROOT}/LICENSE" license_sha)
if(NOT license_sha STREQUAL "cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30")
    message(FATAL_ERROR "LICENSE is not the Apache License, Version 2.0 text")
endif()
file(READ "${SOURCE_ROOT}/LICENSE" license_text)
if(NOT license_text MATCHES "Apache License" OR
   NOT license_text MATCHES "Version 2.0, January 2004" OR
   NOT license_text MATCHES "http://www.apache.org/licenses/")
    message(FATAL_ERROR "LICENSE does not contain the Apache-2.0 grant")
endif()
if(license_text MATCHES "Permission is hereby granted")
    message(FATAL_ERROR "LICENSE still contains the MIT grant")
endif()

file(READ "${SOURCE_ROOT}/NOTICE" notice_text)
if(NOT notice_text MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()

foreach(document README.md AGENT.md docs/License.md)
    file(READ "${SOURCE_ROOT}/${document}" document_text)
    if(NOT document_text MATCHES "Apache-2.0" AND NOT document_text MATCHES "Apache License 2.0")
        message(FATAL_ERROR "${document} does not state Apache-2.0")
    endif()
    if(document_text MATCHES "SPDX-License-Identifier:[ \t]*MIT" OR
       document_text MATCHES "\\[MIT License\\]")
        message(FATAL_ERROR "${document} still claims the MIT license")
    endif()
endforeach()

file(READ "${SOURCE_ROOT}/cmake/iiAudioGenConfig.cmake.in" package_config)
if(NOT package_config MATCHES "set\\(iiAudioGen_SPDX_LICENSE \"Apache-2.0\"\\)")
    message(FATAL_ERROR "Package config does not export iiAudioGen_SPDX_LICENSE")
endif()
file(READ "${SOURCE_ROOT}/CMakeLists.txt" build_script)
if(NOT build_script MATCHES "set\\(iiAudioGen_SPDX_LICENSE \"Apache-2.0\"\\)")
    message(FATAL_ERROR "CMake project does not set iiAudioGen_SPDX_LICENSE")
endif()
if(NOT build_script MATCHES "install\\(FILES LICENSE NOTICE")
    message(FATAL_ERROR "CMake install rules do not copy LICENSE and NOTICE")
endif()

if(DEFINED BINARY_DIR AND EXISTS "${BINARY_DIR}/iiAudioGenConfig.cmake")
    file(READ "${BINARY_DIR}/iiAudioGenConfig.cmake" installed_config)
    if(NOT installed_config MATCHES "set\\(iiAudioGen_SPDX_LICENSE \"Apache-2.0\"\\)")
        message(FATAL_ERROR "Generated package config does not export Apache-2.0")
    endif()
endif()
